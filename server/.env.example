# Room lifetime in milliseconds (default 4 hours)
ROOM_TTL_MS=14400000

# Maximum viewers per room
MAX_VIEWERS=1

# HTTP / WebSocket port
PORT=3001

# Comma-separated allowed origins, or * for development
CORS_ORIGIN=*

# Built-in TURN relay for local testing (set TURN_ENABLED=false to disable)
TURN_ENABLED=true
TURN_PORT=3478
TURN_USERNAME=camora
TURN_PASSWORD=camora

# Optional shared secret for admin cleanup endpoints
ADMIN_SECRET=
