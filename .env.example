# Camora mobile app — copy to `.env` and fill in values.
# Never commit real TURN credentials.

# Signaling server (Socket.IO). Use your PC LAN IP for device testing.
# Examples:
#   http://192.168.1.20:3001
#   https://camora-signaling.example.com
EXPO_PUBLIC_SIGNALING_URL=http://localhost:3001

# Comma-separated STUN servers (public Google STUN is fine for development)
EXPO_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# TURN is REQUIRED for reliable streaming across different mobile networks / NATs.
# Deploy coturn (or a hosted TURN provider) and paste credentials here.
EXPO_PUBLIC_TURN_SERVER=turn:YOUR_TURN_HOST:3478
EXPO_PUBLIC_TURN_USERNAME=camora
EXPO_PUBLIC_TURN_PASSWORD=change-me
