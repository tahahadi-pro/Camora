{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_SIGNALING_URL": "http://10.226.251.200:3001"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SIGNALING_URL": "https://camora-signaling-server.onrender.com",
        "EXPO_PUBLIC_TURN_SERVER": "turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp",
        "EXPO_PUBLIC_TURN_USERNAME": "openrelayproject",
        "EXPO_PUBLIC_TURN_PASSWORD": "openrelayproject"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SIGNALING_URL": "https://camora-signaling-server.onrender.com",
        "EXPO_PUBLIC_TURN_SERVER": "turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp",
        "EXPO_PUBLIC_TURN_USERNAME": "openrelayproject",
        "EXPO_PUBLIC_TURN_PASSWORD": "openrelayproject"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
